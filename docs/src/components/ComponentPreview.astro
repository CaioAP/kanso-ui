---
/**
 * The playground: a live component in both frameworks, prop knobs, and the
 * real example source.
 *
 * The framework toggle is the single most important interaction on the site —
 * it is the thesis, demonstrated. Both islands are rendered and one is hidden,
 * so switching is instant and neither has to re-mount.
 *
 * It is rendered as the *file tabs* on the source block — `Switch.vue` and
 * `Switch.tsx` — rather than as a separate pair of buttons above the preview.
 * The earlier arrangement had two pieces of chrome naming the same thing: a
 * Vue/React tablist in the top bar, and Expressive Code's frame title reading
 * `Switch.vue` directly below it. One tab now owns both regions, which
 * `aria-controls` supports as a space-separated idref list.
 *
 * The known cost: the switcher sits below the preview it controls, so flipping
 * to React changes a component that may be above the fold. Accepted — the
 * filename is what a reader is looking for when they want the other framework,
 * and duplicated chrome was the worse problem. See docs/09, Phase 5.2.
 *
 * The keyboard behaviour comes from the library, as docs/06 §6 asks — but from
 * `@caioalfonso/kanso-core` directly rather than from the Vue or React adapter.
 * Mounting the toggle as an island of one framework would make the choice
 * between them lopsided, and would put a third hydration boundary above the two
 * playground islands. Driving the core from a plain script says the stronger
 * thing anyway: the behaviour needs no framework at all.
 *
 * No editable REPL, deliberately — see docs/06 §6.
 */
// Starlight's Code, not astro:components' — Starlight swaps Shiki out for
// Expressive Code, so only Expressive Code is themed to match the site, and it
// brings its own accessible copy button (docs/06 §6's requirement, met without
// hand-rolling a clipboard interaction).
import { Code } from '@astrojs/starlight/components';

interface Props {
  /** Raw source of the Vue example, imported with `?raw` so it cannot drift. */
  vueSource: string;
  /** Raw source of the React example, imported with `?raw`. */
  reactSource: string;
  /** Accessible name for the whole preview, e.g. "Switch". */
  label: string;
}

const { vueSource, reactSource, label } = Astro.props;

// Filenames, not framework names. They are the tab labels, so they are also the
// accessible names — WCAG 2.5.3 wants those to match, and the e2e specs select
// on them.
const files = { vue: `${label}.vue`, react: `${label}.tsx` };
---

{/*
  `not-content` is Starlight's own escape hatch, and it is load-bearing rather
  than cosmetic. Component pages are markdown, so everything here renders inside
  `.sl-markdown-content`, where this rule applies:

      .sl-markdown-content :not(a, strong, em, …)
        + :not(a, strong, em, …, :where(.not-content *)) { margin-top: 1rem }

  Every element with a preceding sibling picked up 16px of top margin it never
  asked for: the switch label dropped below its own track, the second framework
  tab sat lower than the first, and the field's error message gained 16px on top
  of the field's own gap. The class only excludes *descendants*, so `.preview`
  itself stays in the markdown flow and keeps its `margin-block`.

  Expressive Code sets the same class on its own frames, for the same reason.
  The `/embed/*` routes are plain `.astro` pages outside `.sl-markdown-content`
  and never had the defect — which is the proof the cause is the host page and
  not the components. See docs/09, Phase 5.2.
*/}
<div class="preview not-content" data-preview>
  <div class="preview-bar">
    <button type="button" class="preview-theme" data-theme-toggle aria-pressed="false">
      Dark preview
    </button>
  </div>

  <div class="preview-body" data-preview-body>
    <div
      role="tabpanel"
      id={`${label}-panel-vue`}
      aria-labelledby={`${label}-tab-vue`}
      data-panel="vue"
    >
      <slot name="vue" />
    </div>
    <div
      role="tabpanel"
      id={`${label}-panel-react`}
      aria-labelledby={`${label}-tab-react`}
      data-panel="react"
      hidden
    >
      <slot name="react" />
    </div>
  </div>

  <div class="preview-source">
    {/*
      Named from `label`, not hardcoded. Both filenames read "Switch" until
      Phase 3, so the Tabs page announced its example as `Switch.vue` — a
      component built before there was a second component to notice it with.
    */}
    <div role="tablist" aria-label={`${label} framework`} class="preview-files">
      <button
        type="button"
        role="tab"
        id={`${label}-tab-vue`}
        aria-controls={`${label}-panel-vue ${label}-source-vue`}
        aria-selected="true"
        data-framework="vue"
      >
        {files.vue}
      </button>
      <button
        type="button"
        role="tab"
        id={`${label}-tab-react`}
        aria-controls={`${label}-panel-react ${label}-source-react`}
        aria-selected="false"
        tabindex="-1"
        data-framework="react"
      >
        {files.react}
      </button>
    </div>

    {/*
      No `title` on either block. Expressive Code renders a frame header from it,
      which would stack a second copy of the filename directly under the tabs.
    */}
    <div data-source="vue" id={`${label}-source-vue`}>
      <Code code={vueSource} lang="vue" />
    </div>
    <div data-source="react" id={`${label}-source-react`} hidden>
      <Code code={reactSource} lang="tsx" />
    </div>
  </div>
</div>

<script>
  // The library's own roving-focus arithmetic. `getRovingItems` is deliberately
  // not used with it: the toggle's tabs are not inside an element core owns an
  // id for, and the array is right here. The reusable part is the arithmetic;
  // the DOM read never was.
  import { getRovingIndex, getRovingMove } from '@caioalfonso/kanso-core';

  for (const preview of document.querySelectorAll<HTMLElement>('[data-preview]')) {
    // Scoped to [data-framework], not to [role="tab"]. A preview whose subject
    // is itself a tablist contains other tabs, and querying by role swept them
    // up: their aria-selected and tabindex were rewritten on every toggle and
    // their arrow keys were hijacked. Nothing on the Switch page could show it.
    const tabs = [...preview.querySelectorAll<HTMLButtonElement>('[data-framework]')];

    const select = (framework: string) => {
      for (const tab of tabs) {
        const selected = tab.dataset.framework === framework;
        tab.setAttribute('aria-selected', String(selected));
        // Roving tabindex: only the selected tab is in the tab order, so Tab
        // moves past the tablist rather than through every option.
        tab.tabIndex = selected ? 0 : -1;
      }

      for (const panel of preview.querySelectorAll<HTMLElement>('[data-panel]')) {
        panel.hidden = panel.dataset.panel !== framework;
      }
      for (const block of preview.querySelectorAll<HTMLElement>('[data-source]')) {
        block.hidden = block.dataset.source !== framework;
      }
    };

    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', () => select(tab.dataset.framework ?? 'vue'));

      tab.addEventListener('keydown', (event) => {
        // Which key means what, and where the move lands, both come from core.
        // `undefined` means the key is not ours — and leaving it alone is the
        // point, so ArrowDown still scrolls the page. Home and End work here now
        // as a side effect of using the real thing.
        const move = getRovingMove(event.key, 'horizontal');
        if (move === undefined) return;

        const next = tabs[getRovingIndex(move, { current: index, count: tabs.length })];
        if (next === undefined) return;

        event.preventDefault();
        select(next.dataset.framework ?? 'vue');
        next.focus();
      });
    }

    // Flips the preview only, so light and dark can be compared without
    // changing the page around it.
    const themeToggle = preview.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const body = preview.querySelector<HTMLElement>('[data-preview-body]');
    themeToggle?.addEventListener('click', () => {
      const dark = themeToggle.getAttribute('aria-pressed') === 'true';
      themeToggle.setAttribute('aria-pressed', String(!dark));
      body?.setAttribute('data-theme', dark ? 'light' : 'dark');
    });
  }
</script>

<style>
  .preview {
    margin-block: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
  }

  .preview-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
  }

  .preview-theme {
    padding: 0.25rem 0.625rem;
    border: 1px solid transparent;
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  /*
   * The file tabs. Styled from the kanso tokens rather than Expressive Code's
   * --ec-frm-edActTab* variables, even though EC exposes them: the docs theme
   * already derives EC's palette from kanso, so --ec-frm-edBg *is*
   * --kanso-surface, and reading the token directly keeps every pair in this
   * component measurable by `pnpm contrast`.
   *
   * Both labels stay at full --kanso-fg contrast. The selected tab is marked by
   * its background and a 2px accent rule, never by dimming the other one — a
   * dimmed tab is an unmeasured colour pair and a worse affordance.
   */
  .preview-files {
    display: flex;
    background: var(--kanso-surface-sunk);
    border-block-end: 1px solid var(--sl-color-gray-5);
  }

  .preview-files button {
    padding: 0.375rem 0.75rem;
    border: 0;
    /* Reserved on both tabs, so selecting one does not shift the row. */
    border-block-start: 2px solid transparent;
    background: none;
    color: var(--kanso-fg);
    /* `font-family`, not the `font` shorthand: `--sl-font-mono` is a family list
       and Starlight leaves it unset unless a theme fills it in, so
       `font: var(--sl-font-mono, …)` is either invalid or resolves to `inherit`
       — the tabs would have rendered in the prose face above a mono code block.
       The system-mono fallback is Starlight's own resolution order. */
    font-family: var(--sl-font-mono, var(--sl-font-system-mono, monospace));
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .preview-files button[aria-selected='true'] {
    /* Merges into the code block below it — same surface, no seam. */
    border-block-start-color: var(--kanso-accent);
    background: var(--kanso-surface);
  }

  .preview-body {
    display: flex;
    min-height: 8rem;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    /* The preview carries its own theme, so it needs its own background. */
    background: var(--kanso-bg);
    color: var(--kanso-fg);
  }

  .preview-source {
    border-block-start: 1px solid var(--sl-color-gray-5);
  }

  /* Expressive Code sets its own margins; inside the frame they are wrong. */
  .preview-source :global(.expressive-code) {
    margin: 0;
  }

  /* Layout for the islands themselves, shared by both frameworks. */
  .preview :global(.preview-stage) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .preview :global(.preview-knobs) {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--kanso-line);
    font-size: 0.8125rem;
  }

  .preview :global(.preview-knobs legend) {
    padding-inline: 0.25rem;
    color: var(--kanso-fg-muted);
  }

  .preview :global(.preview-knobs label) {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
  }

  /* Components that fill their container need a width to fill. Not part of the
     library — a preview-only constraint, so the demo does not stretch to the
     full page. */
  .preview :global(.preview-field),
  .preview :global(.preview-card) {
    width: min(24rem, 100%);
  }

  .preview :global(.preview-knobs select) {
    font: inherit;
    min-height: 1.75rem;
  }
</style>
