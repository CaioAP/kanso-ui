{
  "name": "@caioalfonso/kanso-core",
  "version": "1.0.1",
  "description": "Framework-agnostic behaviour core for kanso-ui — state, keyboard, ARIA and focus, with zero dependencies.",
  "license": "MIT",
  "author": "Caio Alfonso",
  "homepage": "https://github.com/CaioAP/kanso-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaioAP/kanso-ui.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/CaioAP/kanso-ui/issues",
  "keywords": [
    "headless",
    "accessibility",
    "a11y",
    "wai-aria",
    "components",
    "kanso"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "import": "./dist/switch.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "import": "./dist/field.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "package-lint": "publint --strict && attw --pack . --profile esm-only"
  }
}
