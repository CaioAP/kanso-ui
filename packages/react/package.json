{
  "name": "@caioalfonso/kanso-react",
  "version": "0.0.2",
  "description": "React 19 adapter for kanso-ui — reactivity and rendering over the framework-agnostic core.",
  "license": "MIT",
  "author": "Caio Alfonso",
  "homepage": "https://github.com/CaioAP/kanso-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaioAP/kanso-ui.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/CaioAP/kanso-ui/issues",
  "keywords": [
    "react",
    "headless",
    "accessibility",
    "a11y",
    "wai-aria",
    "components",
    "kanso"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "import": "./dist/switch.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "import": "./dist/field.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "package-lint": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@caioalfonso/kanso-core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest-axe": "1.0.0-pre.5"
  }
}
